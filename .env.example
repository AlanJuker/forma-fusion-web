# ---------------------------------------------------------------------------
# Base de datos (Railway inyecta DATABASE_URL automáticamente al añadir Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/formafusion?schema=public"

# ---------------------------------------------------------------------------
# Autenticación del panel de administración
# Genera un secreto con: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-bytes"

# Credenciales del administrador inicial (usadas por el seed)
ADMIN_EMAIL="admin@formafusion.ec"
ADMIN_PASSWORD="FormaFusion2026!"

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
