// Forma & Fusión — esquema de persistencia.
// La capa de dominio no depende de este archivo: los repositorios de
// infraestructura traducen estos modelos a las entidades de `src/domain`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ProjectStatus {
  CONCEPT
  IN_PROGRESS
  COMPLETED
}

enum PublishState {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  location    String
  year        Int
  size        String?
  client      String?
  collaborators String?
  status      ProjectStatus @default(COMPLETED)
  state       PublishState  @default(DRAFT)
  featured    Boolean       @default(false)
  order       Int           @default(0)
  excerpt     String?
  description String?       @db.Text
  coverImage  String
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProjectImage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([state, order])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  caption   String?
  alt       String?
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model NewsPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?
  body        String?      @db.Text
  coverImage  String?
  state       PublishState @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([state, publishedAt])
  @@map("news_posts")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.Text
  photo     String?
  email     String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model Office {
  id        String   @id @default(cuid())
  city      String
  address   String
  country   String
  phone     String?
  email     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offices")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@map("contact_messages")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
