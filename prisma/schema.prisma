// Forma & Fusión — esquema de persistencia.
// La capa de dominio no depende de este archivo: los repositorios de
// infraestructura traducen estos modelos a las entidades de `src/domain`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

/// Estados tal y como los nombra el estudio en su documentación.
enum ProjectStatus {
  DELIVERED // Entregado
  IN_OPERATION // Entregado – En funcionamiento
  FOR_SALE // En venta
  IN_PROGRESS // En ejecución
}

enum PublishState {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  order       Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  projects    Project[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Project {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  location      String
  year          Int
  size          String?
  client        String?
  collaborators String?
  status        ProjectStatus  @default(DELIVERED)
  state         PublishState   @default(DRAFT)
  featured      Boolean        @default(false)
  order         Int            @default(0)
  excerpt       String?
  description   String?        @db.Text
  coverImage    String
  /// Qué zona de la portada se conserva al recortarla en marcos apaisados.
  /// Importa en fotografías verticales, donde el recorte central deja fuera
  /// el edificio.
  coverPosition String         @default("center")
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images        ProjectImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([state, order])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  caption   String?
  alt       String?
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@map("contact_messages")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
